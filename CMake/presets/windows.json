{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "include": [
    "base.json"
  ],
  "configurePresets": [
    {
      "name": "vcpkg-triplet-x64-windows",
      "hidden": true,
      "description": "Set vcpkg target_triplet (shared | dynamic).",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": {
          "type": "BOOL",
          "value": "ON"
        },
        "VCPKG_TARGET_TRIPLET": {
          "type": "STRING",
          "value": "x64-windows"
        }
      },
      "inherits": [
        "vcpkg-default-config"
      ]
    },
    {
      "name": "vcpkg-triplet-x64-windows-static",
      "hidden": true,
      "description": "Set vcpkg target_triplet (non-shared | static).",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": {
          "type": "BOOL",
          "value": "OFF"
        },
        "VCPKG_TARGET_TRIPLET": {
          "type": "STRING",
          "value": "x64-windows-static"
        }
      },
      "inherits": [
        "vcpkg-default-config"
      ]
    },
    {
      "name": "compiler-msvc-vc18",
      "hidden": true,
      "description": "Set VC18 (VS2026) as compiler on Windows.",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": {
          "type": "STRING",
          "value": "cl"
        }
      }
    },
    {
      "name": "vc18-x64-windows",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "v145,host=x64",
        "strategy": "external"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": "Windows",
          "intelliSenseMode": "windows-msvc-x64"
        }
      },
      "inherits": [
        "condition-is-windows",
        "cmake-default-config",
        "cmake-enable-warnings",
        "generator-ninja",
        "compiler-msvc-vc18",
        "build-folders-default",
        "vcpkg-triplet-x64-windows"
      ]
    },
    {
      "name": "vc18-x64-windows-static",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "v145,host=x64",
        "strategy": "external"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": "Windows",
          "intelliSenseMode": "windows-msvc-x64"
        }
      },
      "inherits": [
        "condition-is-windows",
        "cmake-default-config",
        "cmake-enable-warnings",
        "generator-ninja",
        "compiler-msvc-vc18",
        "build-folders-default",
        "vcpkg-triplet-x64-windows-static"
      ]
    }
  ]
}
